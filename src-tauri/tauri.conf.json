{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glossline",
  "version": "2026.9.16",
  "identifier": "io.github.ffc225.glossline",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "url": "v2/index.html",
        "title": "Glossline",
        "width": 900,
        "height": 500,
        "minWidth": 360,
        "minHeight": 200,
        "center": true,
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc://localhost wss://stt-rt.soniox.com; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../scripts/*": "scripts/",
      "../LICENSE": "LICENSE.txt",
      "../THIRD-PARTY-LICENSES.md": "THIRD-PARTY-LICENSES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "frameworks": [],
      "minimumSystemVersion": "13.0"
    },
    "createUpdaterArtifacts": false
  }
}
